<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
<!--    <include resource="org/springframework/boot/logging/logback/console-appender.xml" />-->
    <!--    <property name="LOG_FILE" value="${LOG_FILE:-${LOG_PATH:-${LOG_TEMP:-${java.io.tmpdir:-/tmp}}/}spring.log}"/>-->
    <property name="LOG_FILE" value="/dev/stdout"/>
    <!--    <include resource="org/springframework/boot/logging/logback/file-appender.xml" />-->

    <!-- The format picks the whole appender: logback does not support <if> nested inside an <appender>.
         CONSOLE_LOG_STRUCTURED_FORMAT is unset for the text format (ConsoleLogFormatEnvironmentPostProcessor); text or
         an empty value set through Boot's own property keeps the pattern too.
         Logback takes the branch from a <condition> placed right before its <if>; one inside the <if> is ignored. -->
    <condition class="ch.qos.logback.core.boolex.ExpressionPropertyCondition">
        <expression>isNull("CONSOLE_LOG_STRUCTURED_FORMAT") || propertyEquals("CONSOLE_LOG_STRUCTURED_FORMAT", "") || propertyEquals("CONSOLE_LOG_STRUCTURED_FORMAT", "text")</expression>
    </condition>
    <if>
        <then>
            <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
                <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
                    <level>${CONSOLE_LOG_THRESHOLD}</level>
                </filter>
                <filter class="com.otilm.core.tasks.ScheduledLoggingFilter" />
                <encoder>
                    <pattern>${CONSOLE_LOG_PATTERN}</pattern>
                    <charset>${CONSOLE_LOG_CHARSET}</charset>
                </encoder>
            </appender>
        </then>
        <else>
            <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
                <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
                    <level>${CONSOLE_LOG_THRESHOLD}</level>
                </filter>
                <filter class="com.otilm.core.tasks.ScheduledLoggingFilter" />
                <encoder class="com.otilm.core.logging.LogRecordStructuredLogEncoder">
                    <format>${CONSOLE_LOG_STRUCTURED_FORMAT}</format>
                    <charset>${CONSOLE_LOG_CHARSET}</charset>
                </encoder>
            </appender>
        </else>
    </if>

    <!-- Attached whether or not OpenTelemetry is enabled: the OpenTelemetry starter installs the SDK into this
         appender only when it is, so it exports nothing otherwise. Logback cannot see the OTEL_SDK_DISABLED
         switch, so a condition here would stop log export exactly when OpenTelemetry is on. -->
    <appender name="OpenTelemetry" class="io.opentelemetry.instrumentation.logback.appender.v1_0.OpenTelemetryAppender">
        <captureExperimentalAttributes>true</captureExperimentalAttributes>
        <captureCodeAttributes>true</captureCodeAttributes>
        <captureMarkerAttribute>false</captureMarkerAttribute>
    </appender>

    <appender name="SpanEvents" class="com.otilm.core.config.SpanEventsAppender" />

    <root level="INFO">
        <appender-ref ref="CONSOLE" />
        <!--        <appender-ref ref="FILE" />-->
        <appender-ref ref="OpenTelemetry" />
        <appender-ref ref="SpanEvents" />
    </root>
    <logger name="com.otilm" level="INFO"/>
</configuration>